{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.usparty.party/kyn/credential-presentation.v1.json",
  "title": "KYN minimum-disclosure credential presentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["presentation_id", "issuer", "audience", "pairwise_subject", "claim", "assurance", "issued_at", "expires_at", "status_reference", "receipt_id", "proof"],
  "properties": {
    "presentation_id": {"type": "string", "pattern": "^prs_[A-Za-z0-9_-]{8,120}$"},
    "issuer": {"type": "string", "format": "uri"},
    "audience": {"type": "string", "minLength": 1, "maxLength": 200},
    "pairwise_subject": {"type": "string", "pattern": "^pws_[A-Za-z0-9_-]{24,120}$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "definition_version", "policy_version"],
      "properties": {
        "type": {"type": "string", "minLength": 3, "maxLength": 120},
        "definition_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "method_class", "verification_bases"],
      "properties": {
        "state": {"enum": ["provisional", "active"]},
        "method_class": {"type": "string", "minLength": 3, "maxLength": 80},
        "verification_bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["self_asserted", "bootstrap_vouched", "peer_attested", "official_source_checked", "independently_reviewed", "audit_corroborated"]}
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status_reference": {"type": "string", "format": "uri"},
    "receipt_id": {"type": "string", "pattern": "^rcp_[A-Za-z0-9_-]{32,120}$"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key_id", "value"],
      "properties": {
        "type": {"const": "Ed25519Signature2020"},
        "key_id": {"type": "string", "minLength": 3, "maxLength": 200},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
