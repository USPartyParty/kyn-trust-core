#!/usr/bin/env bash
set -euo pipefail

[[ "${EUID}" -eq 0 ]] || {
  printf 'KYN restore wrapper must run as root.\n' >&2
  exit 1
}
readonly config="${KYN_BACKUP_CONFIG:-/etc/kyn-backup/backup.conf}"
[[ -f "${config}" ]] || {
  printf 'KYN backup configuration is absent.\n' >&2
  exit 1
}
set -a
# shellcheck disable=SC1090 -- fixed root-owned configuration path
source "${config}"
set +a
exec /usr/local/libexec/kyn/kyn-restore-test "$@"
